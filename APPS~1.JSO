          },
          {
            "i": "company_capacity_table",
            "x": 20,
            "y": 8,
            "w": 20,
            "h": 8,
            "state": { "params": { "ticker": "NUE" } }
          },
          {
            "i": "company_capacity",
            "x": 0,
            "y": 16,
            "w": 20,
            "h": 12,
            "state": { "params": { "ticker": "NUE" } }
          },
          {
            "i": "company_briefing",
            "x": 20,
            "y": 16,
            "w": 20,
            "h": 12,
            "state": { "params": { "ticker": "NUE" } }
          }
        ]
      }
    },
    "groups": [
      {
        "name": "Company",
        "type": "param",
        "paramName": "ticker",
        "defaultValue": "NUE",
